{
  "manifest_version": 3,
  "name": "Peneira",
  "version": "1.9",
  "description": "Encontra uma aba pelo título ou endereço enquanto você digita.",
  "browser_specific_settings": {
    "gecko": {
      "id": "peneira@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["tabs"],
  "background": { "scripts": ["icon.js"] },
  "action": {
    "default_title": "Peneira",
    "default_popup": "popup.html",
    "default_icon": "icons/toolbar-dark.svg",
    "theme_icons": [
      { "light": "icons/toolbar-light.svg", "dark": "icons/toolbar-dark.svg", "size": 16 },
      { "light": "icons/toolbar-light.svg", "dark": "icons/toolbar-dark.svg", "size": 32 }
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Period", "mac": "Command+Period" },
      "description": "Abrir a Peneira"
    }
  },
  "icons": { "48": "icons/peneira.svg", "96": "icons/peneira.svg" }
}
